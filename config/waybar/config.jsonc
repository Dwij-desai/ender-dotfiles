{
    "layer": "top",
    "position": "top",
    "height": 40,

    // Workspace navigation
    "modules-left": [
        "hyprland/workspaces"
    ],

    // Active window context
    "modules-center": [
        "hyprland/window"
    ],

    // System status and utilities
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "tray"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "Ⅰ",
            "2": "Ⅱ",
            "3": "Ⅲ",
            "4": "Ⅳ",
            "5": "Ⅴ",
            "active": "●",
            "default": "○"
        }
    },

    // Focused application title
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    // Processor usage
    "cpu": {
        "format": "CPU {usage}%"
    },

    // Memory usage
    "memory": {
        "format": "RAM {used:0.1f}G"
    },

    // Network connection status
    "network": {
        "format-wifi": "WiFi",
        "format-ethernet": "Ethernet",
        "format-disconnected": "OFF",
        "tooltip-format-wifi": "Interface: {ifname}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nSignal: Wired\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Network disconnected",
        "on-click": "$HOME/.config/waybar/scripts/network-panel.sh",
        "on-click-right": "$HOME/.config/waybar/scripts/network-nmtui.sh"
    },

    // Audio volume
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": ["", "", ""]
    },

    // Battery charge state
    "battery": {
        "format": "{capacity}%"
    },

    // Date and time
    "clock": {
        "format": "{:%H:%M | %a %d %b}"
    },

    // System tray icons
    "tray": {
        "spacing": 8
    }
}
